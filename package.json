{
  "name": "slidev-theme-giornata",
  "version": "0.1.4",
  "author": "Kaveh Rafie",
  "description": "A Slidev theme for teaching art history — color schemes, layouts, sticky notes, admonitions, and more.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "node": ">=18.0.0",
    "slidev": ">=52.11.3"
  },
  "scripts": {
    "build": "slidev build example.md -o docs/public/example --base /slidev-theme-giornata/example/",
    "dev": "slidev example.md",
    "export": "slidev export example.md",
    "screenshot": "slidev export screenshot.md --format png --output docs/public/screenshots/",
    "screenshot:dev": "slidev screenshot.md",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "typecheck": "vue-tsc --noEmit",
    "ci:publish": "npm publish --access public --no-git-checks",
    "release": "bumpp package.json"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/twemoji": "^1.2.5",
    "@iconify-json/uim": "^1.2.3",
    "@iconify/vue": "^4.3.0",
    "@mdit/plugin-sub": "^0.12.0",
    "@slidev/types": "^52.18.0",
    "@vueuse/core": "^14.4.0",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-implicit-figures": "^0.12.0",
    "markdown-it-mark": "^4.0.0",
    "qrcode.vue": "^3.10.0",
    "yaml": "^2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kavehrafie/slidev-theme-giornata.git"
  },
  "bugs": {
    "url": "https://github.com/Kavehrafie/slidev-theme-giornata/issues"
  },
  "homepage": "https://Kavehrafie.github.io/slidev-theme-giornata/",
  "slidev": {
    "colorSchema": "both",
    "highlighter": "all"
  },
  "files": [
    "layouts",
    "components",
    "styles",
    "setup",
    "layoutHelper.ts",
    "uno.config.ts",
    "vite.config.ts",
    "env.d.ts",
    "global-top.vue",
    "slide-bottom.vue"
  ],
  "devDependencies": {
    "@slidev/cli": "^52.18.0",
    "@types/geojson": "^7946.0.0",
    "@types/markdown-it": "^14.1.2",
    "bumpp": "^9.11.1",
    "playwright-chromium": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-slidev": "^1.0.5",
    "vitepress": "^1.6.4",
    "vue-tsc": "^3.3.8"
  }
}
